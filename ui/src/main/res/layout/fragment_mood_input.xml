<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/moodTitleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/moodInputHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Come ti senti?"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/calendar"
                app:tint="@color/black" />
            <TextView
                android:id="@+id/currentDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Oggi"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Griglia emozioni -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:rowCount="3">

                    <!-- Felice -->
                    <androidx.cardview.widget.CardView android:id="@+id/cardFelice" android:layout_width="0dp" android:layout_height="100dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="8dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/mood_yellow" app:cardCornerRadius="15dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/felice" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Felice" android:textColor="@color/black" android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Sereno -->
                    <androidx.cardview.widget.CardView android:id="@+id/cardSereno" android:layout_width="0dp" android:layout_height="100dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="8dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/mood_teal" app:cardCornerRadius="15dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/sereno" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sereno" android:textColor="@color/black" android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Neutrale -->
                    <androidx.cardview.widget.CardView android:id="@+id/cardNeutrale" android:layout_width="0dp" android:layout_height="100dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="8dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/mood_gray" app:cardCornerRadius="15dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/neutro" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Neutrale" android:textColor="@color/black" android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Triste -->
                    <androidx.cardview.widget.CardView android:id="@+id/cardTriste" android:layout_width="0dp" android:layout_height="100dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="8dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/mood_blue" app:cardCornerRadius="15dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/triste" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Triste" android:textColor="@color/black" android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Arrabbiato -->
                    <androidx.cardview.widget.CardView android:id="@+id/cardArrabbiato" android:layout_width="0dp" android:layout_height="100dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="8dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/mood_red" app:cardCornerRadius="15dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/arrabbiato" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Arrabbiato" android:textColor="@color/black" android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Stressato -->
                    <androidx.cardview.widget.CardView android:id="@+id/cardStressato" android:layout_width="0dp" android:layout_height="100dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="8dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/mood_purple" app:cardCornerRadius="15dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/stressato" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stressato" android:textColor="@color/black" android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </GridLayout>
                <!-- Nota opzionale -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Note della giornata"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editMoodNote"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edit_text_background"
                    android:gravity="top"
                    android:hint="Raccontaci qualcosa..."
                    android:padding="15dp"
                    android:textSize="14sp" />
                <!-- Bottone salva -->
                <Button
                    android:id="@+id/saveMoodButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="@color/button_login_green"
                    android:text="Salva Mood"
                    android:textColor="@color/black"
                    app:cornerRadius="15dp" />
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>
</RelativeLayout>